                "register"
              ]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeded', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Login returns access and refresh tokens', function () {",
                  "    const responseBody = pm.response.json();",
                  "    pm.expect(responseBody).to.have.property('access').that.is.a('string').and.not.empty;",
                  "    pm.expect(responseBody).to.have.property('refresh').that.is.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('access_token', responseBody.access);",
                  "    pm.collectionVariables.set('refresh_token', responseBody.refresh);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
