{
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.jj": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "node_modules": true
  },
  "hide-files.files": [],
  "chat.tools.terminal.autoApprove": {
    "/^git status --short && printf '\\\\nTop-level:\\\\n' && find \\. -maxdepth 2 -type f \\| sort \\| head -80$/": {
      "approve": true,
      "matchCommandLine": true
    }
  }
}
